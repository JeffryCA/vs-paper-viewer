{
  "name": "paper-viewer",
  "displayName": "Paper Viewer",
  "description": "Read and annotate research papers in VS Code.",
  "version": "0.0.1",
  "publisher": "jeffryca",
  "license": "MIT",
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "annotate",
    "annotation",
    "highlight",
    "markup",
    "draw",
    "notes"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeffryCA/vs-paper-viewer.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "paperViewer.editor",
        "displayName": "Paper Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Paper Viewer",
      "properties": {
        "paper-viewer.default.cursor": {
          "markdownDescription": "The default cursor tool.",
          "type": "string",
          "default": "select",
          "enum": [
            "select",
            "hand"
          ]
        },
        "paper-viewer.default.scale": {
          "markdownDescription": "The default zoom level. Allowed values are `auto`, `page-actual`, `page-fit`, `page-width`, and 1-based scale values. (`1.0` means 100%)",
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$"
        },
        "paper-viewer.default.sidebar": {
          "markdownDescription": "Show the sidebar on load.",
          "type": "boolean",
          "default": false
        },
        "paper-viewer.default.scrollMode": {
          "markdownDescription": "The default scroll mode.",
          "type": "string",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped"
          ]
        },
        "paper-viewer.default.spreadMode": {
          "markdownDescription": "The default spread mode.",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ]
        },
        "paper-viewer.highlightColor": {
          "description": "The color used for new text highlights.",
          "type": "string",
          "enum": [
            "yellow",
            "green",
            "blue",
            "pink",
            "purple"
          ],
          "default": "yellow"
        },
        "paper-viewer.textHighlightThickness": {
          "description": "Height of new text highlights as a percentage of the selected text's height.",
          "type": "integer",
          "minimum": 60,
          "maximum": 100,
          "default": 80
        },
        "paper-viewer.citations.enabled": {
          "description": "Open resolved citations in your browser. Option-click (Alt-click) always jumps to the bibliography.",
          "type": "boolean",
          "default": true
        },
        "paper-viewer.citations.destination": {
          "description": "Which arXiv page to open for a cited preprint.",
          "type": "string",
          "enum": [
            "abstract",
            "html",
            "pdf"
          ],
          "default": "abstract"
        }
      }
    },
    "commands": [
      {
        "command": "paperViewer.highlightSelection",
        "title": "Highlight Selection",
        "category": "Paper Viewer"
      },
      {
        "command": "paperViewer.toggleHighlightMode",
        "title": "Toggle Highlight Mode",
        "category": "Paper Viewer"
      }
    ],
    "keybindings": [
      {
        "command": "paperViewer.highlightSelection",
        "key": "ctrl+alt+h",
        "mac": "ctrl+cmd+h",
        "when": "activeCustomEditorId == paperViewer.editor && !inputFocus"
      },
      {
        "command": "paperViewer.toggleHighlightMode",
        "key": "ctrl+alt+shift+h",
        "mac": "ctrl+cmd+shift+h",
        "when": "activeCustomEditorId == paperViewer.editor && !inputFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
